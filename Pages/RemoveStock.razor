@page "/remove-stock"
@page "/remove-stock/{ProductId}"
@using Inventory.API.Models
@inject HttpClient Http
@inject NavigationManager Nav

<div class="card">
    <div class="card-header">
        <span class="card-icon">📤</span>
        <h3>Remove Stock (Sale)</h3>
    </div>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success">✅ @successMsg</div>
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger">⚠️ @errorMsg</div>
    }

    <div class="form-grid">
        <div class="form-group full-width">
            <label>Select Product *</label>
            <select class="form-control" @bind="selectedProductId">
                <option value="">-- Select a product --</option>
                @foreach (var p in products)
                {
                    <option value="@p.Id">@p.ProductName (@p.ProductCode) — Stock: @p.TotalStock</option>
                }
            </select>
            @if (productError)
            {
                <span class="validation-msg">Please select a product.</span>
            }
        </div>
        <div class="form-group">
            <label>Quantity to Remove *</label>
            <input class="form-control @(qtyError ? "is-invalid" : "")" type="number" min="0.01" step="0.01" @bind="qty" placeholder="Enter quantity" />
            @if (qtyError)
            {
                <span class="validation-msg">Enter a valid quantity greater than 0.</span>
            }
        </div>
    </div>

    <div class="actions-row">
        <button class="btn btn-danger" @onclick="Submit" disabled="@submitting">
            @if (submitting)
            {
                <span>Processing...</span>
            }
            else
            {
                <span>📤 Remove Stock</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/products")'>Back to Products</button>
    </div>
</div>

@code {
    [Parameter] public string? ProductId { get; set; }
    List<Product> products = new();
    string selectedProductId = "";
    decimal qty;
    bool productError, qtyError, submitting;
    string successMsg = "", errorMsg = "";

    protected override async Task OnInitializedAsync()
    {
        try { products = await Http.GetFromJsonAsync<List<Product>>("api/product?pageSize=1000") ?? new(); }
        catch { }
        if (!string.IsNullOrEmpty(ProductId)) selectedProductId = ProductId;
    }

    async Task Submit()
    {
        productError = string.IsNullOrEmpty(selectedProductId);
        qtyError = qty <= 0;
        if (productError || qtyError) return;

        submitting = true; successMsg = ""; errorMsg = "";
        try
        {
            var res = await Http.PostAsync($"api/product/remove-stock?productId={selectedProductId}&qty={qty}", null);
            if (res.IsSuccessStatusCode)
            {
                successMsg = $"Successfully removed {qty} units!";
                qty = 0;
                products = await Http.GetFromJsonAsync<List<Product>>("api/product?pageSize=1000") ?? new();
            }
            else { errorMsg = await res.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { submitting = false; }
    }
}